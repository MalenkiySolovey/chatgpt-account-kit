<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ChatGpt.Accounts</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Authors>Malenkiy Solovey</Authors>
    <Description>Credential identity, validation and subscription metadata primitives for ChatGPT accounts.</Description>
    <PackageTags>chatgpt;openai;accounts;identity;credentials</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/MalenkiySolovey/chatgpt-account-kit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MalenkiySolovey/chatgpt-account-kit</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
